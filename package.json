{
  "name": "email-deliverability-mcp",
  "version": "0.1.0",
  "description": "MCP server that checks email deliverability: SPF, DKIM, DMARC and MX records, sending IP blocklists and reverse DNS, and email headers against Gmail and Yahoo sender requirements.",
  "type": "module",
  "bin": {
    "email-deliverability-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "email",
    "deliverability",
    "spf",
    "dkim",
    "dmarc",
    "blocklist",
    "dnsbl",
    "claude"
  ],
  "homepage": "https://ownmailserver.com/claude-email-connector",
  "author": "OwnMailServer <hello@ownmailserver.com> (https://ownmailserver.com)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kryptoscan/email-deliverability-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kryptoscan/email-deliverability-mcp/issues"
  }
}
